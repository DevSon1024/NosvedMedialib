<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="NosvedMedia Sample Player"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/diagnosticsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="Decoder: Initializing..."
        android:textColor="#81C784"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHwOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HW Only"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fallback (HW+SW)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPreferSw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prefer SW"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSeekBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-10s"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSeekForward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10s"
                android:textSize="11sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:use_controller="true" />

</LinearLayout>
